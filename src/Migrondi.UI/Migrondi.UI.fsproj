<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Ships as the `migrondiui` .NET tool beside the binary archives. -->
    <PackageId>MigrondiUI</PackageId>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>migrondiui</ToolCommandName>
    <Title>Migrondi UI</Title>
    <Description>The Migrondi desktop app: manage local and virtual migration projects, run and roll back migrations, and serve them over MCP.</Description>
    <PackageTags>migrondi;sql;migrations;desktop;mcp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Logic/Paths.fs" />
    <Compile Include="Logic/Database.fs" />
    <Compile Include="Logic/VirtualFs.fs" />
    <Compile Include="Logic/Services.fs" />
    <Compile Include="Logic/Projects.fs" />
    <Compile Include="Logic/OsOperations.fs" />
    <Compile Include="Logic/Migrations.fs" />
    <Compile Include="Logic/Host.fs" />
    <Compile Include="Mcp/Server.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="Host.fs" />
    <Compile Include="Feedback.fs" />
    <Compile Include="Views/Common.fs" />
    <Compile Include="Views/MigrationEditor.fs" />
    <Compile Include="Views/ProjectSettings.fs" />
    <Compile Include="Views/ProjectSettingsPage.fs" />
    <Compile Include="Views/Landing.fs" />
    <Compile Include="Views/ProjectDetails.fs" />
    <Compile Include="Views/NewProject.fs" />
    <Compile Include="Views/Shell.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CLIWrap" />
    <PackageReference Include="Donald" />
    <PackageReference Include="FunGoo" />
    <PackageReference Include="FunGoo.Widgets" />
    <PackageReference Include="FsToolkit.ErrorHandling" />
    <PackageReference Include="Goo" />
    <PackageReference Include="Goo.Widgets" />
    <PackageReference Include="IcedTasks" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Navs.Goo" />
    <PackageReference Include="TextMateSharp" />
    <PackageReference Include="TextMateSharp.Grammars" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Migrondi.Core\Migrondi.Core.fsproj" />
    <ProjectReference Include="..\Migrondi.Mcp\Migrondi.Mcp.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Content
      Include="Logic/migrations/**"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
      Link="migrations/%(RecursiveDir)%(Filename)%(Extension)"
      Pack="false"
    />
    <!-- A tool package has no contentFiles; the app's own migrations must sit
         in the tools folder beside the assembly. -->
    <None
      Include="Logic/migrations/**"
      Pack="true"
      PackagePath="tools/$(TargetFramework)/any/migrations/"
    />
  </ItemGroup>

</Project>
