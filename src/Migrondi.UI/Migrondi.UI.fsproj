<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Logic/Database.fs" />
    <Compile Include="Logic/VirtualFs.fs" />
    <Compile Include="Logic/Services.fs" />
    <Compile Include="Logic/Projects.fs" />
    <Compile Include="Logic/OsOperations.fs" />
    <Compile Include="Logic/Migrations.fs" />
    <Compile Include="Logic/Host.fs" />
    <Compile Include="Mcp/Server.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="Host.fs" />
    <Compile Include="Feedback.fs" />
    <Compile Include="Views/Common.fs" />
    <Compile Include="Views/ProjectSettings.fs" />
    <Compile Include="Views/Landing.fs" />
    <Compile Include="Views/ProjectDetails.fs" />
    <Compile Include="Views/NewProject.fs" />
    <Compile Include="Views/Shell.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CLIWrap" />
    <PackageReference Include="Donald" />
    <PackageReference Include="FunGoo" />
    <PackageReference Include="FunGoo.Widgets" />
    <PackageReference Include="FsToolkit.ErrorHandling" />
    <PackageReference Include="Goo" />
    <PackageReference Include="Goo.Widgets" />
    <PackageReference Include="IcedTasks" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Navs.Goo" />
    <PackageReference Include="TextMateSharp" />
    <PackageReference Include="TextMateSharp.Grammars" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Migrondi.Core\Migrondi.Core.fsproj" />
    <ProjectReference Include="..\Migrondi.Mcp\Migrondi.Mcp.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Content
      Include="Logic/migrations/**"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
      Link="migrations/%(RecursiveDir)%(Filename)%(Extension)"
    />
  </ItemGroup>

</Project>
