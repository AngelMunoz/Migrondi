{
    "version": "@VERSION@",
    "description": "Migrondi desktop app: manage local and virtual migration projects and serve them over MCP",
    "homepage": "https://github.com/AngelMunoz/Migrondi",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/AngelMunoz/Migrondi/releases/download/v@VERSION@/migrondiui-@VERSION@-win-x64.zip",
            "hash": "@HASH@"
        }
    },
    "bin": [
        ["Migrondi.UI.exe", "migrondiui"]
    ],
    "shortcuts": [
        ["Migrondi.UI.exe", "Migrondi UI"]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AngelMunoz/Migrondi/releases/download/v$version/migrondiui-$version-win-x64.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
